# Copy to .env (or set these in your host's dashboard) and fill in real values.

# Required in production. Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated at boot and everyone is signed out on restart.
SESSION_SECRET=

# Storage. When set, Postgres is used; otherwise data/store.json.
# REQUIRED on Render/Railway — their filesystems are ephemeral.
# A free Neon database works: https://neon.tech
DATABASE_URL=

# Admin account, seeded on first boot as a normal user row with role: 'admin'.
# If ADMIN_PASSWORD is empty a random one is generated and printed once at startup.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Canonical origin used to build the shareable profile link, e.g.
# https://kurdbio.onrender.com — falls back to the incoming request's host.
PUBLIC_BASE_URL=

# Comma separated extra origins allowed to call the API. Empty = same-origin only.
CORS_ORIGIN=

# Set by the host; only override locally.
PORT=4000
NODE_ENV=production

# Where the JSON fallback store lives when DATABASE_URL is unset.
DATA_FILE=data/store.json
